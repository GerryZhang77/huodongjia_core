{
  "openapi": "3.0.3",
  "info": {
    "title": "活动家 - 收藏管理 API",
    "version": "1.0.0",
    "description": "C端用户收藏管理相关接口，包括获取收藏列表、添加收藏、取消收藏、切换收藏状态等功能。"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API 基础路径"
    }
  ],
  "tags": [
    {
      "name": "收藏管理",
      "description": "用户活动收藏管理"
    }
  ],
  "paths": {
    "/user/favorites": {
      "get": {
        "summary": "获取收藏列表",
        "description": "获取当前用户收藏的所有活动列表。",
        "operationId": "getFavorites",
        "tags": ["收藏管理"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取收藏列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoritesListResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "activities": [
                      {
                        "id": "ua_001",
                        "title": "2024 创业者年度盛会",
                        "coverImage": "https://picsum.photos/400/200?random=1",
                        "eventStartTime": "2024-03-15T09:00:00Z",
                        "eventEndTime": "2024-03-15T18:00:00Z",
                        "location": "北京·国家会议中心",
                        "maxParticipants": 500,
                        "currentParticipants": 423,
                        "tags": ["创业", "投资", "商业"],
                        "userStatus": "approved",
                        "activityStatus": "recruiting",
                        "isFavorite": true,
                        "organizer": {
                          "id": "org_001",
                          "name": "活动家官方",
                          "avatar": "https://i.pravatar.cc/100?img=10"
                        }
                      },
                      {
                        "id": "ua_003",
                        "title": "深圳创业者交流会",
                        "coverImage": "https://picsum.photos/400/200?random=3",
                        "eventStartTime": "2024-03-25T19:00:00Z",
                        "eventEndTime": "2024-03-25T21:00:00Z",
                        "location": "深圳·南山科技园",
                        "maxParticipants": 100,
                        "currentParticipants": 78,
                        "tags": ["创业", "交友", "社交"],
                        "userStatus": "recruiting",
                        "activityStatus": "recruiting",
                        "isFavorite": true,
                        "organizer": {
                          "id": "org_003",
                          "name": "深圳创业圈",
                          "avatar": "https://i.pravatar.cc/100?img=30"
                        }
                      }
                    ],
                    "total": 2
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user/favorites/{activityId}": {
      "post": {
        "summary": "添加收藏",
        "description": "将指定活动添加到用户的收藏列表。",
        "operationId": "addFavorite",
        "tags": ["收藏管理"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "activityId",
            "in": "path",
            "required": true,
            "description": "活动ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "收藏成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteToggleResponse"
                },
                "example": {
                  "success": true,
                  "message": "收藏成功",
                  "isFavorite": true
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "活动不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "活动不存在"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "取消收藏",
        "description": "将指定活动从用户的收藏列表中移除。",
        "operationId": "removeFavorite",
        "tags": ["收藏管理"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "activityId",
            "in": "path",
            "required": true,
            "description": "活动ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "取消收藏成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteToggleResponse"
                },
                "example": {
                  "success": true,
                  "message": "已取消收藏",
                  "isFavorite": false
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user/activities/{activityId}/favorite": {
      "post": {
        "summary": "切换收藏状态",
        "description": "切换指定活动的收藏状态。如果已收藏则取消，未收藏则添加。",
        "operationId": "toggleFavorite",
        "tags": ["收藏管理"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "activityId",
            "in": "path",
            "required": true,
            "description": "活动ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "切换成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FavoriteToggleResponse"
                },
                "examples": {
                  "added": {
                    "summary": "添加收藏",
                    "value": {
                      "success": true,
                      "message": "收藏成功",
                      "isFavorite": true
                    }
                  },
                  "removed": {
                    "summary": "取消收藏",
                    "value": {
                      "success": true,
                      "message": "已取消收藏",
                      "isFavorite": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "活动不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserActivity": {
        "type": "object",
        "description": "用户活动信息",
        "properties": {
          "id": {
            "type": "string",
            "description": "活动ID"
          },
          "title": {
            "type": "string",
            "description": "活动标题"
          },
          "description": {
            "type": "string",
            "description": "活动描述"
          },
          "coverImage": {
            "type": "string",
            "description": "封面图片URL"
          },
          "eventStartTime": {
            "type": "string",
            "format": "date-time",
            "description": "活动开始时间"
          },
          "eventEndTime": {
            "type": "string",
            "format": "date-time",
            "description": "活动结束时间"
          },
          "location": {
            "type": "string",
            "description": "活动地点"
          },
          "maxParticipants": {
            "type": "integer",
            "description": "最大参与人数"
          },
          "currentParticipants": {
            "type": "integer",
            "description": "当前参与人数"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "活动标签"
          },
          "userStatus": {
            "type": "string",
            "enum": ["recruiting", "pending", "approved", "completed"],
            "description": "用户在此活动的状态"
          },
          "activityStatus": {
            "type": "string",
            "enum": ["recruiting", "ongoing", "completed"],
            "description": "活动状态"
          },
          "isFavorite": {
            "type": "boolean",
            "description": "是否已收藏"
          },
          "organizer": {
            "$ref": "#/components/schemas/Organizer"
          }
        },
        "required": [
          "id",
          "title",
          "coverImage",
          "eventStartTime",
          "eventEndTime",
          "location",
          "maxParticipants",
          "currentParticipants",
          "tags",
          "userStatus",
          "activityStatus",
          "organizer"
        ]
      },
      "Organizer": {
        "type": "object",
        "description": "活动组织者",
        "properties": {
          "id": {
            "type": "string",
            "description": "组织者ID"
          },
          "name": {
            "type": "string",
            "description": "组织者名称"
          },
          "avatar": {
            "type": "string",
            "description": "组织者头像URL"
          }
        },
        "required": ["id", "name", "avatar"]
      },
      "FavoritesListResponse": {
        "type": "object",
        "description": "收藏列表响应",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "是否成功"
          },
          "data": {
            "type": "object",
            "properties": {
              "activities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UserActivity"
                },
                "description": "收藏的活动列表"
              },
              "total": {
                "type": "integer",
                "description": "收藏总数"
              }
            },
            "required": ["activities", "total"]
          }
        },
        "required": ["success"]
      },
      "FavoriteToggleResponse": {
        "type": "object",
        "description": "收藏操作响应",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "是否成功"
          },
          "message": {
            "type": "string",
            "description": "响应消息"
          },
          "isFavorite": {
            "type": "boolean",
            "description": "当前收藏状态"
          }
        },
        "required": ["success"]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "错误响应",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "description": "错误消息"
          },
          "code": {
            "type": "string",
            "description": "错误代码"
          }
        },
        "required": ["success", "message"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT 认证令牌"
      }
    }
  }
}
