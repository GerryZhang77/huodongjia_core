{
  "openapi": "3.0.3",
  "info": {
    "title": "活动家 - 账号设置 API",
    "version": "1.0.0",
    "description": "C端用户账号设置相关接口，包括修改密码、删除账号等功能"
  },
  "servers": [
    {
      "url": "/api",
      "description": "API 基础路径"
    }
  ],
  "tags": [
    {
      "name": "账号设置",
      "description": "用户账号管理"
    }
  ],
  "paths": {
    "/user/password": {
      "put": {
        "summary": "修改密码",
        "description": "修改当前用户的登录密码，需要提供旧密码进行验证。",
        "operationId": "changePassword",
        "tags": ["账号设置"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              },
              "example": {
                "oldPassword": "oldPassword123",
                "newPassword": "newSecurePassword456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "密码修改成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true,
                  "message": "密码修改成功"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "wrongPassword": {
                    "summary": "旧密码错误",
                    "value": {
                      "success": false,
                      "message": "旧密码不正确",
                      "code": "WRONG_PASSWORD"
                    }
                  },
                  "weakPassword": {
                    "summary": "新密码强度不足",
                    "value": {
                      "success": false,
                      "message": "新密码强度不足，请使用至少8位包含字母和数字的密码",
                      "code": "WEAK_PASSWORD"
                    }
                  },
                  "samePassword": {
                    "summary": "新旧密码相同",
                    "value": {
                      "success": false,
                      "message": "新密码不能与旧密码相同",
                      "code": "SAME_PASSWORD"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/user/account": {
      "delete": {
        "summary": "删除账号",
        "description": "永久删除当前用户账号及所有相关数据。此操作不可逆，请谨慎操作。",
        "operationId": "deleteAccount",
        "tags": ["账号设置"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "账号删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true,
                  "message": "账号已删除"
                }
              }
            }
          },
          "401": {
            "description": "未授权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "无法删除账号",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "message": "您有进行中的活动，无法删除账号",
                  "code": "HAS_ACTIVE_ENROLLMENTS"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "type": "object",
        "description": "修改密码请求",
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "旧密码",
            "minLength": 6
          },
          "newPassword": {
            "type": "string",
            "description": "新密码（至少8位，包含字母和数字）",
            "minLength": 8,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*#?&]{8,}$"
          }
        },
        "required": ["oldPassword", "newPassword"]
      },
      "SuccessResponse": {
        "type": "object",
        "description": "成功响应",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "响应消息"
          }
        },
        "required": ["success"]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "错误响应",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "description": "错误消息"
          },
          "code": {
            "type": "string",
            "description": "错误代码"
          }
        },
        "required": ["success", "message"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT 认证令牌"
      }
    }
  }
}
