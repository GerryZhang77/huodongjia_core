# ========================================
# 本地联调环境 - 连接本地后端
# ========================================
# 使用命令: npm run dev:local
# 描述: 连接本地真实后端服务进行联调
# 前提: 后端服务已启动 (npm run server:dev)
# ========================================

NODE_ENV=development

# Mock 模式控制
# - false: 连接真实后端
# - msw: 使用 MSW Mock 数据
VITE_USE_MOCK=false

# 本地后端 API Base URL
# 后端运行在 3006 端口 (Express) + 5000 端口 (Python Word2Vec)
VITE_API_BASE_URL=http://127.0.0.1:3006
