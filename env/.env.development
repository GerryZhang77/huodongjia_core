# ========================================
# 开发环境 - 真实后端
# ========================================
# 使用命令: npm run dev
# 描述: 连接本地真实后端服务 (localhost:3001)
# ========================================

NODE_ENV=development

# Mock 模式控制
VITE_USE_MOCK=false

# 真实后端 API Base URL
VITE_API_BASE_URL=http://localhost:3001

# ========================================
# Apifox 配置（真实后端不需要）
# ========================================
# 以下配置在真实后端模式下不使用，但保留结构以便切换

# VITE_AUTH_MOCK_URL=
# VITE_EVENT_MOCK_URL=
# VITE_MATCHING_MOCK_URL=
# VITE_EMBEDDING_MOCK_URL=
# VITE_REGISTRATION_MOCK_URL=
# VITE_APIFOX_TOKEN=
