# ========================================
# 开发环境 - MSW 本地 Mock（推荐）
# ========================================
# 使用命令: npm run dev
# 描述: 使用 MSW (Mock Service Worker) 本地拦截请求
# 无需启动后端服务，开箱即用
# ========================================

NODE_ENV=development

# Mock 模式控制
# - msw: 使用 MSW 本地 Mock（推荐）
# - false: 连接真实后端
VITE_USE_MOCK=msw

# 真实后端 API Base URL（MSW 模式下不使用）
# 当 VITE_USE_MOCK=false 时生效
VITE_API_BASE_URL=http://localhost:3001

