/**
 * 用户端首页 - 活动广场
 * 展示热门活动推荐和活动列表，支持搜索和多维筛选
 */

import { FC, useState, useMemo, useRef } from "react";
import { useNavigate } from "react-router-dom";
import {
  Search,
  MapPin,
  Calendar,
  SlidersHorizontal,
  ChevronRight,
  ChevronDown,
  Flame,
  X,
} from "lucide-react";
import { UserLayout } from "@/components/layout/UserLayout";
import { Tag } from "@/components/ui";
import { mockUserActivities, UserActivity } from "@/mocks/data/user-activities";
import dayjs from "dayjs";

// ============ 类型定义 ============

interface FilterTag {
  id: string;
  label: string;
  icon?: React.ElementType;
}

// ============ 常量配置 ============

// 筛选标签配置
const filterTags: FilterTag[] = [
  { id: "all", label: "全部" },
  { id: "nearby", label: "附近", icon: MapPin },
  { id: "weekend", label: "本周末", icon: Calendar },
  { id: "free", label: "免费" },
  { id: "outdoor", label: "户外" },
  { id: "social", label: "社交" },
];

// 城市列表
const cities = ["全国", "北京", "上海", "广州", "深圳", "杭州", "成都"];

// 排序选项
const sortOptions = [
  { value: "recommend", label: "推荐" },
  { value: "latest", label: "最新" },
  { value: "hot", label: "最热" },
  { value: "time", label: "开始时间" },
];

// 活动卡片渐变色
const cardGradients = [
  "from-primary-400 to-primary-500",
  "from-secondary-400 to-secondary-500",
  "from-accent-400 to-accent-500",
  "from-emerald-400 to-emerald-500",
];

// ============ 工具函数 ============

const formatDate = (dateStr: string): string => {
  const d = dayjs(dateStr);
  const weekdays = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];
  return `${d.format("M月D日")} ${weekdays[d.day()]} ${d.format("HH:mm")}`;
};

const formatShortDate = (dateStr: string): string => {
  const d = dayjs(dateStr);
  const today = dayjs();
  const tomorrow = today.add(1, "day");

  if (d.isSame(today, "day")) return `今天 ${d.format("HH:mm")}`;
  if (d.isSame(tomorrow, "day")) return `明天 ${d.format("HH:mm")}`;
  return d.format("M/D HH:mm");
};

// ============ 子组件 ============

/**
 * 热门活动卡片 - 横向滑动展示
 */
const HotActivityCard: FC<{
  activity: UserActivity;
  gradient: string;
  onClick: () => void;
}> = ({ activity, gradient, onClick }) => {
  const isAlmostFull =
    activity.currentParticipants / activity.maxParticipants >= 0.8;

  return (
    <div
      onClick={onClick}
      className={`
        flex-shrink-0 w-[280px] h-[160px] rounded-2xl overflow-hidden
        bg-gradient-to-br ${gradient}
        cursor-pointer transition-all duration-300
        hover:shadow-lg hover:-translate-y-1 active:scale-[0.98]
        relative
      `}
    >
      {/* 背景图片叠加 */}
      {activity.coverImage && (
        <div className="absolute inset-0">
          <img
            src={activity.coverImage}
            alt=""
            className="w-full h-full object-cover opacity-30"
          />
        </div>
      )}

      {/* 渐变遮罩 */}
      <div className="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />

      {/* 内容 */}
      <div className="relative h-full p-4 flex flex-col justify-between text-white">
        {/* 顶部标签 */}
        <div className="flex items-center gap-2">
          {isAlmostFull && (
            <span className="px-2 py-0.5 bg-white/20 backdrop-blur-sm rounded-full text-[10px] font-semibold flex items-center gap-1">
              <Flame size={10} />
              即将满员
            </span>
          )}
          <span className="px-2 py-0.5 bg-white/20 backdrop-blur-sm rounded-full text-[10px] font-medium">
            {activity.tags[0]}
          </span>
        </div>

        {/* 底部信息 */}
        <div>
          <h3 className="text-base font-bold line-clamp-2 mb-1.5 leading-snug">
            {activity.title}
          </h3>
          <div className="flex items-center justify-between text-xs text-white/80">
            <span>{formatShortDate(activity.eventStartTime)}</span>
            <span>
              {activity.currentParticipants}/{activity.maxParticipants}人
            </span>
          </div>
        </div>
      </div>
    </div>
  );
};

/**
 * 活动列表卡片
 */
const ActivityListCard: FC<{
  activity: UserActivity;
  onClick: () => void;
}> = ({ activity, onClick }) => {
  const isHot = activity.currentParticipants / activity.maxParticipants >= 0.8;
  const isUpcoming =
    dayjs(activity.eventStartTime).diff(dayjs(), "day") <= 3 &&
    dayjs(activity.eventStartTime).isAfter(dayjs());

  return (
    <div
      onClick={onClick}
      className="bg-white rounded-2xl shadow-sm overflow-hidden flex cursor-pointer hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
    >
      {/* 左侧封面 */}
      <div className="w-28 h-[120px] flex-shrink-0 relative overflow-hidden bg-gray-100">
        {activity.coverImage ? (
          <img
            src={activity.coverImage}
            alt={activity.title}
            className="w-full h-full object-cover"
          />
        ) : (
          <div className="w-full h-full bg-gradient-to-br from-primary-100 to-accent-100 flex items-center justify-center">
            <Calendar size={24} className="text-primary-400" />
          </div>
        )}

        {/* 角标 */}
        {(isHot || isUpcoming) && (
          <div className="absolute top-2 left-2 px-1.5 py-0.5 rounded-md bg-white/90 backdrop-blur-sm">
            <span className="text-[10px] font-semibold text-secondary-500">
              {isHot ? "热门" : "即将开始"}
            </span>
          </div>
        )}
      </div>

      {/* 右侧内容 */}
      <div className="flex-1 p-3 flex flex-col justify-between min-w-0">
        {/* 标题 */}
        <h3 className="text-sm font-bold text-gray-900 line-clamp-2 leading-snug">
          {activity.title}
        </h3>

        {/* 信息 */}
        <div className="space-y-1 mt-1.5">
          <p className="text-[11px] text-gray-500 flex items-center gap-1">
            <Calendar size={12} className="flex-shrink-0 text-gray-400" />
            <span>{formatDate(activity.eventStartTime)}</span>
          </p>
          <p className="text-[11px] text-gray-500 flex items-center gap-1">
            <MapPin size={12} className="flex-shrink-0 text-gray-400" />
            <span className="truncate">{activity.location}</span>
          </p>
        </div>

        {/* 底部 */}
        <div className="flex items-center justify-between mt-2">
          <div className="flex items-center gap-2">
            <span className="text-sm font-bold text-primary-500">免费</span>
            <span className="text-[10px] text-gray-400">
              {activity.currentParticipants}/{activity.maxParticipants}人
            </span>
          </div>
          <div className="flex gap-1">
            {activity.tags.slice(0, 2).map((tag, i) => (
              <Tag
                key={i}
                color={i === 0 ? "primary" : "accent"}
                variant="soft"
                size="small"
              >
                {tag}
              </Tag>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

// ============ 主组件 ============

const UserHome: FC = () => {
  const navigate = useNavigate();
  const searchInputRef = useRef<HTMLInputElement>(null);

  // 状态
  const [searchText, setSearchText] = useState("");
  const [activeFilter, setActiveFilter] = useState("all");
  const [selectedCity, setSelectedCity] = useState("全国");
  const [sortBy, setSortBy] = useState("recommend");
  const [showSortMenu, setShowSortMenu] = useState(false);
  const [showCitySelector, setShowCitySelector] = useState(false);

  // 热门活动（取参与率最高的前4个）
  const hotActivities = useMemo(() => {
    return [...mockUserActivities]
      .filter((a) => a.activityStatus === "recruiting")
      .sort(
        (a, b) =>
          b.currentParticipants / b.maxParticipants -
          a.currentParticipants / a.maxParticipants
      )
      .slice(0, 4);
  }, []);

  // 过滤和排序活动列表
  const filteredActivities = useMemo(() => {
    let result = [...mockUserActivities];

    // 搜索过滤
    if (searchText.trim()) {
      const keyword = searchText.toLowerCase();
      result = result.filter(
        (a) =>
          a.title.toLowerCase().includes(keyword) ||
          a.location.toLowerCase().includes(keyword) ||
          a.tags.some((t) => t.toLowerCase().includes(keyword))
      );
    }

    // 城市过滤
    if (selectedCity !== "全国") {
      result = result.filter((a) => a.location.includes(selectedCity));
    }

    // 标签过滤
    if (activeFilter !== "all") {
      switch (activeFilter) {
        case "outdoor":
          result = result.filter(
            (a) => a.tags.includes("户外") || a.tags.includes("运动")
          );
          break;
        case "social":
          result = result.filter(
            (a) => a.tags.includes("社交") || a.tags.includes("交友")
          );
          break;
        case "weekend":
          result = result.filter((a) => {
            const d = dayjs(a.eventStartTime);
            const weekEnd = dayjs().endOf("week");
            return d.isBefore(weekEnd) && d.isAfter(dayjs());
          });
          break;
        default:
          break;
      }
    }

    // 排序
    switch (sortBy) {
      case "latest":
        result.sort(
          (a, b) =>
            new Date(b.eventStartTime).getTime() -
            new Date(a.eventStartTime).getTime()
        );
        break;
      case "hot":
        result.sort(
          (a, b) =>
            b.currentParticipants / b.maxParticipants -
            a.currentParticipants / a.maxParticipants
        );
        break;
      case "time":
        result.sort(
          (a, b) =>
            new Date(a.eventStartTime).getTime() -
            new Date(b.eventStartTime).getTime()
        );
        break;
      default:
        // recommend - 默认排序
        break;
    }

    return result;
  }, [searchText, activeFilter, selectedCity, sortBy]);

  const handleActivityClick = (id: string) => {
    navigate(`/u/activities/${id}`);
  };

  const clearSearch = () => {
    setSearchText("");
    searchInputRef.current?.focus();
  };

  return (
    <UserLayout showTabBar={true} showTopBar={false} bgColor="bg-slate-50">
      {/* 顶部搜索区域 - 固定 */}
      <header className="sticky top-0 z-40 bg-white shadow-sm">
        {/* 搜索框 */}
        <div className="px-4 pt-4 pb-3">
          <div className="flex items-center gap-3">
            {/* 城市选择 */}
            <button
              onClick={() => setShowCitySelector(true)}
              className="flex items-center gap-0.5 text-sm font-medium text-gray-700 flex-shrink-0"
            >
              <MapPin size={16} className="text-primary-500" />
              <span>{selectedCity}</span>
              <ChevronDown size={14} className="text-gray-400" />
            </button>

            {/* 搜索框 */}
            <div className="flex-1 h-10 bg-slate-100 rounded-full flex items-center px-4 gap-2">
              <Search size={18} className="text-slate-400 flex-shrink-0" />
              <input
                ref={searchInputRef}
                type="text"
                placeholder="搜索活动、地点、标签..."
                value={searchText}
                onChange={(e) => setSearchText(e.target.value)}
                className="flex-1 bg-transparent text-sm text-gray-900 placeholder:text-slate-400 outline-none"
              />
              {searchText && (
                <button
                  onClick={clearSearch}
                  className="p-0.5 rounded-full hover:bg-slate-200"
                >
                  <X size={14} className="text-slate-400" />
                </button>
              )}
            </div>

            {/* 筛选按钮 */}
            <button className="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center flex-shrink-0 hover:bg-primary-100 transition-colors">
              <SlidersHorizontal size={18} className="text-primary-500" />
            </button>
          </div>
        </div>

        {/* 筛选标签 */}
        <div className="px-4 pb-3 overflow-x-auto scrollbar-hide">
          <div className="flex gap-2 min-w-max">
            {filterTags.map((tag) => {
              const Icon = tag.icon;
              const isActive = activeFilter === tag.id;
              return (
                <button
                  key={tag.id}
                  onClick={() => setActiveFilter(tag.id)}
                  className={`
                    h-8 px-4 rounded-full flex items-center gap-1.5 text-xs font-semibold
                    transition-all duration-200
                    ${
                      isActive
                        ? "bg-gray-900 text-white shadow-sm"
                        : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                    }
                  `}
                >
                  {Icon && <Icon size={14} />}
                  {tag.label}
                </button>
              );
            })}
          </div>
        </div>
      </header>

      {/* 页面内容 */}
      <div className="min-h-screen pb-20">
        {/* 热门活动区 */}
        <section className="py-4">
          <div className="px-4 flex items-center justify-between mb-3">
            <div className="flex items-center gap-2">
              <Flame size={18} className="text-secondary-500" />
              <h2 className="text-base font-bold text-gray-900">热门活动</h2>
            </div>
            <button
              onClick={() => setSortBy("hot")}
              className="text-xs text-primary-500 font-medium flex items-center gap-0.5"
            >
              查看更多
              <ChevronRight size={14} />
            </button>
          </div>

          {/* 横向滑动卡片 */}
          <div className="overflow-x-auto scrollbar-hide">
            <div className="flex gap-3 px-4 min-w-max">
              {hotActivities.map((activity, index) => (
                <HotActivityCard
                  key={activity.id}
                  activity={activity}
                  gradient={cardGradients[index % cardGradients.length]}
                  onClick={() => handleActivityClick(activity.id)}
                />
              ))}
            </div>
          </div>
        </section>

        {/* 活动列表区 */}
        <section className="px-4">
          {/* 标题和排序 */}
          <div className="flex items-center justify-between py-3">
            <h2 className="text-base font-bold text-gray-900">全部活动</h2>
            <div className="relative">
              <button
                onClick={() => setShowSortMenu(!showSortMenu)}
                className="text-xs text-slate-600 flex items-center gap-1"
              >
                {sortOptions.find((s) => s.value === sortBy)?.label}
                <ChevronDown
                  size={12}
                  className={`text-slate-400 transition-transform ${
                    showSortMenu ? "rotate-180" : ""
                  }`}
                />
              </button>
              {showSortMenu && (
                <>
                  <div
                    className="fixed inset-0 z-40"
                    onClick={() => setShowSortMenu(false)}
                  />
                  <div className="absolute right-0 top-6 w-24 bg-white rounded-xl shadow-lg border border-gray-100 z-50 overflow-hidden">
                    {sortOptions.map((option) => (
                      <button
                        key={option.value}
                        onClick={() => {
                          setSortBy(option.value);
                          setShowSortMenu(false);
                        }}
                        className={`w-full px-3 py-2.5 text-xs text-left hover:bg-slate-50 ${
                          sortBy === option.value
                            ? "text-primary-500 font-semibold"
                            : "text-slate-600"
                        }`}
                      >
                        {option.label}
                      </button>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>

          {/* 结果计数 */}
          <p className="text-xs text-slate-400 mb-3">
            共 {filteredActivities.length} 个活动
          </p>

          {/* 活动列表 */}
          <div className="space-y-3">
            {filteredActivities.length === 0 ? (
              <div className="py-16 text-center">
                <Search size={40} className="text-slate-200 mx-auto mb-3" />
                <p className="text-slate-400 text-sm">没有找到相关活动</p>
                <button
                  onClick={() => {
                    setSearchText("");
                    setActiveFilter("all");
                    setSelectedCity("全国");
                  }}
                  className="mt-4 px-6 py-2 bg-primary-500 text-white text-sm font-medium rounded-full hover:bg-primary-600 transition-colors"
                >
                  重置筛选
                </button>
              </div>
            ) : (
              filteredActivities.map((activity) => (
                <ActivityListCard
                  key={activity.id}
                  activity={activity}
                  onClick={() => handleActivityClick(activity.id)}
                />
              ))
            )}
          </div>
        </section>

        {/* 底部间距 */}
        <div className="h-8" />
      </div>

      {/* 城市选择器弹窗 */}
      {showCitySelector && (
        <>
          <div
            className="fixed inset-0 bg-black/30 z-50"
            onClick={() => setShowCitySelector(false)}
          />
          <div className="fixed bottom-0 left-0 right-0 bg-white rounded-t-2xl z-50 max-w-lg mx-auto animate-in slide-in-from-bottom duration-300">
            <div className="p-4 border-b border-gray-100">
              <div className="flex items-center justify-between">
                <h3 className="text-base font-semibold text-gray-900">
                  选择城市
                </h3>
                <button
                  onClick={() => setShowCitySelector(false)}
                  className="p-1 rounded-full hover:bg-gray-100"
                >
                  <X size={20} className="text-gray-400" />
                </button>
              </div>
            </div>
            <div className="p-4 grid grid-cols-4 gap-3">
              {cities.map((city) => (
                <button
                  key={city}
                  onClick={() => {
                    setSelectedCity(city);
                    setShowCitySelector(false);
                  }}
                  className={`py-3 rounded-xl text-sm font-medium transition-colors ${
                    selectedCity === city
                      ? "bg-primary-500 text-white"
                      : "bg-slate-100 text-slate-700 hover:bg-slate-200"
                  }`}
                >
                  {city}
                </button>
              ))}
            </div>
            {/* 安全区域 */}
            <div className="h-safe-area-bottom pb-4" />
          </div>
        </>
      )}
    </UserLayout>
  );
};

export default UserHome;
